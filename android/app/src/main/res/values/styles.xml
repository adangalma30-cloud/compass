<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Keep the activity surface branded while the WebView is booting. -->
        <item name="android:windowBackground">@drawable/compass_splash_background</item>
        <item name="android:statusBarColor">@color/compass_splash_background</item>
        <item name="android:navigationBarColor">@color/compass_splash_background</item>
        <item name="android:navigationBarDividerColor">@color/compass_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/compass_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/compass_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/compass_splash_background</item>
        <item name="android:navigationBarDividerColor">@color/compass_splash_background</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>