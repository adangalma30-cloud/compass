# Compass configuration
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# Anything prefixed with VITE_ is embedded in the client bundle and is public --
# never put a secret in a VITE_ variable.

# ----------------------------------------------------------------------------
# Authentication (Clerk) -- REQUIRED
# ----------------------------------------------------------------------------
# Without these the app renders "Compass authentication is not configured."
# Get them from https://dashboard.clerk.com -> API keys.

# Client-side key. Public by design, safe to ship in the bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-side key. SECRET -- required by the API to verify session tokens.
CLERK_SECRET_KEY=sk_test_replace_me

# ----------------------------------------------------------------------------
# API location
# ----------------------------------------------------------------------------
# Leave EMPTY for local web development: Vite proxies /api to port 8787.
#
# REQUIRED for an Android build. The APK runs on a device, so "localhost" points
# at the phone itself, not your machine. Set this to a public HTTPS URL that the
# device can reach, otherwise every API call fails and sign-in cannot complete.
#   e.g. VITE_API_URL=https://compass-api.example.com
VITE_API_URL=

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------
# PostgreSQL. Without it the API serves the bundled preview listings and
# favorites are unavailable (the guest experience still works).
DATABASE_URL=

# Server-only. Enables live search, nearby discovery and place photos.
# Never expose this as a VITE_ variable.
GOOGLE_PLACES_API_KEY=

# Port for the API server. Defaults to 8787.
PORT=8787

# Clerk proxy URL. Only needed for advanced/proxied Clerk setups.
VITE_CLERK_PROXY_URL=
