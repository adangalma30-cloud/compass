# Compass configuration
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# Anything prefixed with VITE_ is embedded in the client bundle and is public --
# never put a secret in a VITE_ variable.

# ----------------------------------------------------------------------------
# Authentication (Clerk) -- REQUIRED
# ----------------------------------------------------------------------------
# Without these the app renders "Compass authentication is not configured."
# Get them from https://dashboard.clerk.com -> API keys.

# Client-side key. Public by design, safe to ship in the bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-side key. SECRET -- required by the API to verify session tokens.
CLERK_SECRET_KEY=sk_test_replace_me

# ALSO required by the API server. Clerk's Express middleware needs the
# publishable key as well as the secret; without it the middleware throws on
# every request and the entire API returns 500. Same value as
# VITE_CLERK_PUBLISHABLE_KEY above.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ----------------------------------------------------------------------------
# API location
# ----------------------------------------------------------------------------
# Leave EMPTY for local web development: Vite proxies /api to port 8787.
#
# REQUIRED for an Android build. The APK runs on a device, so "localhost" points
# at the phone itself, not your machine. Set this to a public HTTPS URL that the
# device can reach, otherwise every API call fails and sign-in cannot complete.
#   e.g. VITE_API_URL=https://compass-api.example.com
VITE_API_URL=

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------
# PostgreSQL. Without it the API serves the bundled preview listings and
# favorites are unavailable (the guest experience still works).
DATABASE_URL=

# Business discovery is powered by OpenStreetMap (Nominatim for text search,
# Overpass for nearby lookups). Neither requires an API key, so there is
# nothing to configure here.
#
# Optional: point Overpass at a different mirror or your own instance.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
#
# Optional: Nominatim requires an identifying User-Agent. A sensible default is
# used; override it if you run a fork.
# OSM_USER_AGENT=CompassApp/0.0.6 (contact@example.com)

# Port for the API server. Defaults to 8787.
PORT=8787

# The API's own public URL, set on the SERVER once deployed.
# Place photos are proxied through the API; without this the generated photo
# URLs are relative and will not load inside the Android WebView.
#   e.g. PUBLIC_API_URL=https://compass-api.onrender.com
PUBLIC_API_URL=

# Comma-separated browser origins allowed to call the API, for a deployed web
# build. The Android WebView origins are always permitted.
#   e.g. CORS_ALLOWED_ORIGINS=https://compass.example.com
CORS_ALLOWED_ORIGINS=

# Clerk proxy URL. Only needed for advanced/proxied Clerk setups.
VITE_CLERK_PROXY_URL=
